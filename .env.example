# Copy this file to .env and fill it in. The .env file is ignored by git: never commit your token.

# From @BotFather, after /newbot
CARTULARIO_BOT_TOKEN=

# Your own Telegram id (a number). Find it with:  python cartulario.py --whoami
CARTULARIO_OWNER_ID=

# Optional. Default is a "videos" folder next to the script.
# CARTULARIO_FOLDER=
